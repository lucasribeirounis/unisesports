# Environment Configuration for UNIS eSports Backend
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=3000

# Frontend Configuration
# This is the domain where the HTML frontend will be hosted
FRONTEND_URL=https://unisesports.com.br

# Admin Credentials (change these from defaults!)
ADMIN_USER=admin
ADMIN_PASS=unis2026

# Database
# The database file is created automatically
DATABASE_PATH=esports.db

# Encryption Keys for LGPD-compliant data protection
# Keep these secure and do not commit to version control
# Generate secure keys for production:
#   - ENCRYPTION_KEY: 32-character hex string for AES-256
#   - ENCRYPTION_IV: 16-character hex string for initialization vector
ENCRYPTION_KEY=vOVH6sdmpNWjRRIqCc7rdxs01lwHzfr3
ENCRYPTION_IV=81F5E19A629631EF

# Logging
LOG_LEVEL=info
